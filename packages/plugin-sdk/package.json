{
  "name": "@floti-dev/plugin-sdk",
  "version": "2.0.0",
  "description": "Types, the manifest schema and helpers for building Floti plugins. The runtime - the window.floti bridge, theme tokens and primitives stylesheet - comes from the running Floti.",
  "keywords": [
    "floti-plugin",
    "claude-code",
    "plugin",
    "sdk"
  ],
  "homepage": "https://github.com/floti-dev/floti/wiki/Plugins-Overview",
  "bugs": "https://github.com/floti-dev/floti/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floti-dev/floti.git",
    "directory": "packages/plugin-sdk"
  },
  "license": "Apache-2.0",
  "author": "Cole Taylor",
  "//publish": "Published to npm by release.yml when this version is not on the registry yet. It has no build step: the folder is the package, and `files` is what ships.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src",
    "template",
    "floti-plugin.schema.json",
    "NOTICE"
  ],
  "types": "./src/types.d.ts",
  "exports": {
    ".": {
      "types": "./src/types.d.ts"
    },
    "./global": {
      "types": "./src/global.d.ts"
    },
    "./background": {
      "types": "./src/background.d.ts"
    },
    "./manifest": {
      "types": "./src/manifest.d.ts",
      "default": "./src/manifest.js"
    },
    "./folder": {
      "types": "./src/folder.d.ts",
      "default": "./src/folder.js"
    },
    "./stores": {
      "types": "./src/stores.d.ts",
      "default": "./src/stores.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./vue": {
      "types": "./src/vue.d.ts",
      "default": "./src/vue.js"
    },
    "./floti-plugin.schema.json": "./floti-plugin.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "floti-plugin": "bin/floti-plugin.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.8",
    "svelte": "^5.57.2",
    "vue": "^3.5.43"
  }
}
